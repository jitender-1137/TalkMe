# ============================================================================
#  NeoChatHub infrastructure secrets / config (docker-compose)
#  Copy to `.env` and fill in. NEVER commit the real .env (add it to .gitignore).
#  Generate a strong secret with:
#     openssl rand -base64 32 | tr -d '/+=' | head -c 40
# ============================================================================

# --- Where ports are published. Keep 127.0.0.1 so nothing is exposed to the
#     internet. Only change if the app runs on a DIFFERENT host and you have a
#     firewall / private network in front (then prefer a private IP, not 0.0.0.0).
BIND_HOST=127.0.0.1

# --- Postgres ----------------------------------------------------------------
POSTGRES_DB=talkMe_prod
POSTGRES_USER=talkMe_prod
POSTGRES_PASSWORD=            # REQUIRED — strong, unique
POSTGRES_PORT=5432

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=talkme
RABBITMQ_PASS=               # REQUIRED — strong, unique
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_STOMP_PORT=61613

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=              # REQUIRED — strong, unique
REDIS_HOST=localhost         # set to the server IP when pointing at a REMOTE Redis
REDIS_PORT=6379
# Command timeout (ms). Keep ~2000 for a co-located Redis; RAISE to 6000+ when the
# app talks to a REMOTE Redis over the internet, or WAN jitter trips the reapers.
REDIS_TIMEOUT_MS=6000

# --- Optional image pins (defaults shown) ------------------------------------
# POSTGRES_VERSION=16-alpine
# RABBITMQ_VERSION=3.13-management
# REDIS_VERSION=7-alpine

# --- Per-conversation message encryption (AES-256-GCM) ----------------------
# Each chat gets one data key, stored WRAPPED by the master key below. Text +
# media paths are encrypted at rest (server DB + client IndexedDB). Server-mediated,
# NOT end-to-end — the server can decrypt for push/email previews + moderation.
#
# Feature is DARK (messages stored plaintext) until CRYPTO_MASTER_KEY is set, so
# existing deploys are unaffected until you opt in.
CHAT_ENCRYPTION_ENABLED=true
#
# Master key: base64 of 32 random bytes (AES-256). Generate with:
#     openssl rand -base64 32
# ⚠️ BACK THIS UP like a production database credential. It wraps EVERY per-chat
#    key — if it is lost or changed, all wrapped keys (and thus all encrypted
#    messages, past and present) become PERMANENTLY UNREADABLE. The app fails fast
#    on boot if this key can no longer decrypt existing chat keys. Never rotate it
#    without a re-wrap migration. Keep it OUT of version control.
CRYPTO_MASTER_KEY=bmVvY2hhdGh1Yg==

# --- SuperAdmin -------------------------------------------------------------
# Comma-separated emails granted ROLE_SUPER_ADMIN on boot (full dashboard access).
# The accounts must already exist (sign up first). No spaces. e.g. you@ex.com,ops@ex.com
SUPER_ADMIN_EMAILS=

# --- Public web-app URL ------------------------------------------------------
# Used to build links in transactional emails (verify / reset) and OAuth redirects.
FRONTEND_BASE_URL=https://talkme.fun

# --- Transactional email: Resend (primary) → Brevo (fallback) → SMTP ---------
# Sender domain (neochathub.com) must be DKIM/SPF-verified in BOTH dashboards.
MAIL_ENABLED=true
MAIL_FROM=NeoChatHub <noreply@neochathub.com>
# Resend key: https://resend.com/api-keys  (free ~100/day). NOTE: no inline comments
# after a value — when this file is copied to .env, Spring parses it as .properties and
# would treat a trailing "# ..." as part of the value.
RESEND_API_KEY=
# Brevo key: https://app.brevo.com/settings/keys/api  (free ~300/day)
BREVO_API_KEY=
# Optional tuning (defaults shown)
# RESEND_DAILY_LIMIT=100
# BREVO_DAILY_LIMIT=300
# MAIL_TIMEOUT_MS=10000
# EMAIL_VERIFY_TTL_MIN=1440
# Optional branding (visual palette lives in MailTheme / app.mail.theme.*)
# MAIL_BRAND_NAME=NeoChatHub
# MAIL_SUPPORT_EMAIL=support@neochathub.com
# SMTP — the 3rd fallback link. e.g. a Resend/Brevo relay in prod, or Mailpit locally
# (host localhost, port 1025, auth/starttls off). Enable + configure to use it.
MAIL_SMTP_ENABLED=false
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true

# --- Google OAuth (social login). Blank = disabled ---------------------------
# Authorized redirect URI in Google console: <public-origin>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Session base-auth (admin/actuator). REQUIRED in prod (no defaults) -------
AUTH_USERNAME=admin
# REQUIRED — strong, unique
AUTH_PASSWORD=

# --- Cloudflare Turnstile CAPTCHA. REQUIRED real secret in prod --------------
CAPTCHA_ENABLED=true
# Secret from https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=

# --- Web Push (VAPID). REQUIRED real keys in prod ----------------------------
# Generate a pair with:  npx web-push generate-vapid-keys
WEBPUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@talkme.fun

# --- Content moderation (NSFW sidecar; see docker-compose `nsfw`) ------------
MODERATION_ENABLED=true
NSFW_ENABLED=true
NSFW_BASE_URL=http://localhost:8081

# --- App → RabbitMQ connection (only used when the broker relay is enabled) ---
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# STOMP broker relay for multi-instance WS fan-out. OFF unless RabbitMQ (STOMP on
# :61613) is reachable, else /topic broadcasts fail with "Message broker not active".
# BROKER_RELAY_ENABLED=false
# BROKER_AMQP_EVENTS_ENABLED=false
# BROKER_RELAY_HOST=localhost
# BROKER_RELAY_PORT=61613
# BROKER_RELAY_LOGIN=talkme
# BROKER_RELAY_PASSCODE=
